# =============================================================================
# OmniResolve-AI — Environment Variables
# Copy file ini menjadi .env dan isi nilainya
# JANGAN PERNAH commit file .env ke git!
# =============================================================================

# --- SumoPod / LLM Provider ---
# Base URL dari SumoPod API marketplace (OpenAI-compatible endpoint)
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_API_KEY=your-sumopod-api-key-here
# Model yang tersedia di SumoPod marketplace (ganti sesuai ketersediaan & harga)
# Contoh: claude-3-haiku-20240307, glm-4, gpt-4o-mini, dsb.
LLM_MODEL_NAME=claude-3-haiku-20240307

# --- Telegram Bot ---
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Mode: "polling" (lokal/dev) | "webhook" (production SumoPod)
TELEGRAM_MODE=polling
# URL publik untuk webhook (hanya diisi jika TELEGRAM_MODE=webhook)
# Format: https://your-sumopod-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# ID admin/supervisor untuk notifikasi HITL (cari ID kamu via @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=

# --- Embedding Model (untuk pgvector) ---
# Bisa pakai model embedding dari SumoPod atau provider lain
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_BASE_URL=https://ai.sumopod.com/v1
EMBEDDING_API_KEY=your-sumopod-api-key-here

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omni_resolve
POSTGRES_USER=omni_user
POSTGRES_PASSWORD=change_this_strong_password
# Full DSN (dibuat otomatis dari variabel di atas, tapi bisa di-override)
DATABASE_URL=postgresql+asyncpg://omni_user:change_this_strong_password@postgres:5432/omni_resolve

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
# SECRET untuk JWT (jika diaktifkan)
SECRET_KEY=change_this_to_a_very_long_random_string

# --- Business Logic ---
# Threshold kompensasi untuk Human-in-the-Loop (dalam IDR)
HITL_THRESHOLD_IDR=1000000
# Webhook/email notifikasi supervisor (mock saat development)
SUPERVISOR_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url

# --- Environment ---
ENVIRONMENT=development  # development | production
LOG_LEVEL=INFO

# --- SMTP Notifikasi ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=regosaas@gmail.com
SMTP_PASS=xwziegyo mhyl nxcw
SMTP_FROM=Rego <regosaas@gmail.com>

# --- Public URL ---
BASE_URL=http://localhost:8000
